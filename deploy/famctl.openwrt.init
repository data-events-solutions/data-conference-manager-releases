#!/bin/sh /etc/rc.common
# OpenWrt service: copy to /etc/init.d/famctl, then: chmod +x /etc/init.d/famctl && /etc/init.d/famctl enable
START=99
USE_PROCD=1

start_service() {
    procd_open_instance
    procd_set_param command python3 -m famctl
    procd_set_param env PYTHONPATH=/opt/famctl FAMCTL_PASSWORD=CHANGE_ME FAMCTL_TOTAL_MBIT=100 \
        FAMCTL_LAN_IFACE=br-lan FAMCTL_ROUTER_IP=192.168.1.1
    procd_set_param respawn
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
